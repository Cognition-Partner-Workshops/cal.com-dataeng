# SafeGuard Insurance Claims Management System
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/safeguard_insurance
DB_POOL_MIN=5
DB_POOL_MAX=50

# JWT
JWT_SECRET=your-jwt-secret-key-min-32-chars-long-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-min-32-chars
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption (AES-256-GCM for PII)
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# Server
PORT=3001
NODE_ENV=development

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# Account Lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
